---
{navigationGlyph ? (
  <svg class="navigation-glyph" data-glyph={name} width={size} height={size} viewBox="0 0 24 24"
    aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path class="glyph-anchor" d={navigationGlyph.anchor} />
    <path class="glyph-part" d={navigationGlyph.moving} />
    <path class="glyph-detail" d={navigationGlyph.detail} />
  </svg>
) : (
  <svg data-action-cue={cue || undefined} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill={glyphs[name] ? 'currentColor' : 'none'} stroke={glyphs[name] ? 'none' : 'currentColor'} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={glyphs[name] ?? paths[name] ?? paths.link} /></svg>
)}
