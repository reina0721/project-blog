---
import type { HTMLAttributes } from 'astro/types';
import '../styles/action-feedback.css';
type Props = HTMLAttributes<'a'> & {
  href: string;
  direction?: 'forward' | 'back' | 'external';
};
const { class: className, direction, ...attributes } = Astro.props;
---
<a {...attributes} class:list={['action-link', className]} data-direction={direction}><md-ripple aria-hidden="true"></md-ripple><md-focus-ring aria-hidden="true"></md-focus-ring><slot /></a>
<script>
  import '../lib/press-feedback';
</script>
