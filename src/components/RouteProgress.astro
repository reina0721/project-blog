<div class="route-progress" id="route-progress" hidden role="status">
  <span class="progress-label">正在打开页面</span>
  <md-linear-progress indeterminate aria-hidden="true"></md-linear-progress>
</div>
<style>
  .route-progress {
    position:fixed; z-index:20; inset:0 0 auto; height:3px;
    pointer-events:none; background:var(--pale);
    --md-linear-progress-track-height:3px;
    --md-linear-progress-track-color:var(--pale);
    --md-linear-progress-active-indicator-color:var(--blue);
  }
  .route-progress[hidden] { display:none; }
  .progress-label { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  md-linear-progress {display:block; width:100%;}
  md-linear-progress:not(:defined) {height:100%;width:32%;background:var(--blue);}
  @media (prefers-reduced-motion:reduce) {
    md-linear-progress {display:none;}
    .route-progress {background:var(--blue);}
  }
</style>
<script>
  import '@material/web/progress/linear-progress.js';

  // Resolve the indicator on the current page after a slow request starts.
  let requestSignal: AbortSignal | undefined;
  let visibleIndicator: HTMLElement | null = null;
  let pendingTimer: number | undefined;
  function settle() {
    requestSignal?.removeEventListener('abort', settle);
    requestSignal = undefined;
    window.clearTimeout(pendingTimer);
    pendingTimer = undefined;
    if (visibleIndicator) visibleIndicator.hidden = true;
    visibleIndicator = null;
  }

  document.addEventListener('astro:before-preparation', event => {
    settle();
    requestSignal = event.signal;
    requestSignal.addEventListener('abort', settle, { once: true });
    pendingTimer = window.setTimeout(() => {
      if (event.defaultPrevented) return settle();
      visibleIndicator = document.getElementById('route-progress');
      if (visibleIndicator) visibleIndicator.hidden = false;
    }, 240);

    const load = event.loader;
    event.loader = async () => {
      try {
        await load();
      } catch (error) {
        if (requestSignal === event.signal) settle();
        throw error;
      }
      if (event.defaultPrevented && requestSignal === event.signal) settle();
    };
  });
  document.addEventListener('astro:before-swap', event => {
    if (requestSignal === event.signal) settle();
  });
  window.addEventListener('pagehide', settle);
</script>
