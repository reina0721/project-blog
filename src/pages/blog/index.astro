---
import Shell from '../../layouts/Shell.astro';
import ActionLink from '../../components/ActionLink.astro';
import MaterialEntry from '../../components/MaterialEntry.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, getPosts, postHref, titleTransition } from '../../lib/content';
import '../../styles/pages.css';

const posts = await getPosts();
---

<Shell title="博客" description="按发表时间浏览文章、摘要与分类。" section="blog">
  <div class="inner-page blog-page">
    <header class="view-head" data-enter-group>
      <div>
        <p class="section-label"><span class="section-marker"><Icon name="arrow-right" size={15} /></span> 博客</p>
        <div class="heading-line"><h1>浏览文章</h1><span class="collection-count">{posts.length} 篇</span></div>
      </div>
      <ActionLink class="section-action" variant="text" direction="forward" href="/archive/"><span data-action-label>按年份查找</span><Icon name="arrow-right" size={16} cue /></ActionLink>
    </header>
    {posts.length === 0 && <p class="panel-empty" data-enter-group>这里还没有文章。</p>}
    <ul class="post-list" aria-label="文章列表">
      {posts.map((post) => (
        <li data-enter-group>
          <MaterialEntry class="post-hit" elevated direction="forward" label={post.data.title} href={postHref(post.id)}>
            <h2 slot="headline" id={'title-' + post.id}><span data-action-label data-article-slug={post.id} style={{ viewTransitionName: titleTransition(post.id) }}>{post.data.title}</span></h2>
            <Fragment slot="supporting">
              {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
              <div class="item-meta"><time datetime={post.data.date}>{formatDate(post.data.date)}</time><span>{post.data.category}</span>{post.data.sample && <span>样稿</span>}</div>
            </Fragment>
            <span slot="end" class="hit-arrow" aria-hidden="true"><Icon name="arrow-right" size={21} cue /></span>
          </MaterialEntry>
        </li>
      ))}
    </ul>
  </div>
</Shell>
