---
import Shell from '../../layouts/Shell.astro';
import ActionLink from '../../components/ActionLink.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, postHref, titleTransition } from '../../lib/content';
import '../../styles/pages.css';

const posts = await getPosts();
const years = new Map<string, typeof posts>();
for (const post of posts) {
  const year = post.data.date.slice(0, 4);
  const entries = years.get(year) ?? [];
  entries.push(post);
  years.set(year, entries);
}
---

<Shell title="归档" description="按年份和日期查找文章。" section="archive">
  <div class="inner-page archive-page">
    <header class="view-head">
      <div>
        <p class="section-label"><span class="section-marker"><Icon name="archive" size={15} /></span> 归档</p>
        <h1>按年份查找</h1>
      </div>
      <ActionLink class="section-action" direction="back" href="/blog/"><Icon name="arrow-left" size={15} cue /> <span data-action-label>浏览文章摘要</span></ActionLink>
    </header>
    <div class="surface-panel archive-panel">
      <div class="panel-heading"><h2>时间索引</h2><span>{years.size} 个年份 · {posts.length} 篇</span></div>
      {years.size === 0 && <p class="panel-empty">这里还没有文章。</p>}
      {Array.from(years, ([year, entries]) => (
        <section class="year-group" aria-labelledby={'year-' + year}>
          <h2 id={'year-' + year}>{year}</h2>
          <ul class="timeline-list">
            {entries.map((post) => (
              <li>
                <ActionLink href={postHref(post.id)} class="archive-hit" direction="forward">
                  <time datetime={post.data.date}>{post.data.date.slice(5).replace('-', '.')}</time>
                  <span class="archive-title" data-action-label data-article-slug={post.id} style={{ viewTransitionName: titleTransition(post.id) }}>{post.data.title}</span>
                  <span class="hit-arrow" aria-hidden="true"><Icon name="arrow-right" size={16} cue /></span>
                </ActionLink>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Shell>
