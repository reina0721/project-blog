---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import ActionLink from '../components/ActionLink.astro';
import ProfileSocials from '../components/ProfileSocials.astro';
import { site } from '../data/site';
import { profileAvatar } from '../data/identity';
import { formatDate, getPosts, postHref } from '../lib/content';
import '../styles/home.css';
const [latest] = await getPosts();
---
<Shell section="home">
  <section class="identity-stage" aria-labelledby="owner-name">
    <div class="stage-field" aria-hidden="true"></div>
    <div class="identity-lockup">
      <ActionLink class="portrait-link" href="/about/" aria-label={`了解${site.name}`}>
        <span class="portrait-orbit" aria-hidden="true"></span>
        <span class="portrait-crop">{profileAvatar ? <img src={profileAvatar} alt="" width="720" height="720" fetchpriority="high"/> : <span>{site.name.slice(0,1)}</span>}</span>
        <span class="portrait-burst" aria-hidden="true"><i></i><i></i></span>
      </ActionLink>
      <div class="identity-copy">
        <h1 class="identity-title" id="owner-name">
          <span class="identity-roman" lang="en">{site.romanName}</span>
          <span class="identity-name">{site.name}</span>
        </h1>
        <p class="motto">{site.motto}</p>
        <div class="identity-actions"><ProfileSocials /><ActionLink class="blog-door" direction="forward" href="/blog/"><span data-action-label>进入博客</span><Icon name="arrow" size={17} cue /></ActionLink></div>
      </div>
    </div>
    {latest && <a class="stage-scroll" href="#recent" aria-label="向下查看最近文章"><span lang="en">SCROLL</span><i aria-hidden="true"></i></a>}
  </section>
  {latest && <section class="recent-area" id="recent" aria-labelledby="recent-title">
    <div class="recent-content">
      <div class="recent-heading"><span class="heading-key" aria-hidden="true"><Icon name="book" size={21}/></span><h2 id="recent-title">最近文章</h2></div>
      <ActionLink class="recent-story" direction="forward" href={postHref(latest.id)}><div><time datetime={latest.data.date}>{formatDate(latest.data.date)}</time><h3><span data-action-label data-article-slug={latest.id}>{latest.data.title}</span></h3>{latest.data.summary && <p>{latest.data.summary}</p>}</div><span class="story-go"><Icon name="arrow" size={22} cue /></span></ActionLink>
    </div>
  </section>}
</Shell>
