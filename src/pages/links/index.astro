---
import Shell from '../../layouts/Shell.astro';
import MaterialEntry from '../../components/MaterialEntry.astro';
import Icon from '../../components/Icon.astro';
import { designReferences, friends } from '../../data/friends';
import { site } from '../../data/site';
import '../../styles/pages.css';

const groups = [
  { title: '好友站点', entries: friends },
  ...(site.sample ? [{ title: '设计参考', entries: designReferences }] : []),
];
---

<Shell title="友链" description="浏览好友的个人站点与本站的设计参考。" section="links">
  <div class="inner-page directory-page">
    <header class="view-head" data-enter-group>
      <div>
        <p class="section-label"><span class="section-marker"><Icon name="arrow-up-right" size={15} /></span> 友链</p>
        <h1>站点目录</h1>
      </div>
    </header>
    <div class="directory-groups">
      {groups.map((group) => (
        <section class="directory-group" data-enter-group>
          <div class="panel-heading"><h2>{group.title}</h2><span>{group.entries.length} 个站点</span></div>
          {group.entries.length === 0 && <p class="panel-empty">没有一个朋友，好可怜。</p>}
          <ul class="friend-grid" style={{ '--site-count': group.entries.length }}>
            {group.entries.map((friend) => (
              <li>
                <MaterialEntry class="friend-hit" label={friend.name} href={friend.url} rel="external" direction="external">
                  <span slot="start" class="friend-avatar" aria-hidden="true">
                    {friend.avatar ? <img src={friend.avatar} alt="" loading="lazy" width="48" height="48" /> : Array.from(friend.name)[0]}
                  </span>
                  <span slot="headline" class="friend-name"><span data-action-label>{friend.name}</span> <span class="friend-direction"><Icon name="arrow-up-right" size={13} cue /></span></span>
                  {friend.description && <span slot="supporting" class="friend-description">{friend.description}</span>}
                </MaterialEntry>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Shell>
