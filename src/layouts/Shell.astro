---
import { ClientRouter } from 'astro:transitions';
import BrandLockup from '../components/BrandLockup.astro';
import Icon from '../components/Icon.astro';
import ActionLink from '../components/ActionLink.astro';
import RouteProgress from '../components/RouteProgress.astro';
import SiteNav from '../components/SiteNav.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/motion.css';
interface Props { title?: string; description?: string; section?: 'home' | 'blog' | 'archive' | 'links' | 'about'; reading?: boolean; }
const { title, description = site.motto, section, reading = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN" style={`--blue:${site.themeColor}`}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={site.themeColor} /><meta name="description" content={description} />
    <title>{title ? `${title} · ${site.brand}` : `${site.name} · ${site.brand}`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <script is:inline>
      // Reading history from older builds predates Astro's navigation index.
      if (history.state?.blueNotesReading && !Number.isInteger(history.state.index)) {
        history.replaceState({ ...history.state, index: 0, scrollX, scrollY }, '');
      }
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-section={section}>
    <RouteProgress />
    <a class="skip" href="#main">跳到正文</a>
    <div class="site-viewport">
      <header class="site-header">
        <div class="site-leading" data-leading={reading ? 'back' : 'brand'}>
          <span class="leading-current">
            {reading ? (
              <ActionLink href="/blog/" variant="icon" class="reading-back" direction="back" data-reading-back aria-label="返回博客">
                <Icon name="arrow-left" size={24} cue />
              </ActionLink>
            ) : (
              <ActionLink href="/" variant="text" class="brand" direction="back" aria-label={`${site.brand}主页`}>
                <BrandLockup />
              </ActionLink>
            )}
          </span>
          {reading ? (
            <span class="leading-art brand" aria-hidden="true" inert><BrandLockup /></span>
          ) : (
            <span class="leading-art reading-back" aria-hidden="true" inert><Icon name="arrow-left" size={24} /></span>
          )}
        </div>
        <SiteNav section={section}/>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <script>
      import '@material/web/ripple/ripple.js';
      import '@material/web/focus/md-focus-ring.js';
      import '../lib/motion';
      import '../lib/header-scroll';
      import '../lib/article-gallery';
    </script>
  </body>
</html>
